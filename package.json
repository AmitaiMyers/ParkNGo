{
  "name": "parkngo",
  "version": "0.1.0",
  "description": "Drive or ride to free parking outside congestion, then continue by public transport.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:data": "node scripts/build-parking-data.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmitaiMyers/ParkNGo.git"
  },
  "bugs": {
    "url": "https://github.com/AmitaiMyers/ParkNGo/issues"
  },
  "homepage": "https://github.com/AmitaiMyers/ParkNGo#readme",
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
